# Amazon domain: com, com.tr, de, co.uk, ...
AMAZON_DOMAIN=com.tr

# Minimum price drop to notify (percent). Example: 5 = %5+ düşüş
MIN_DROP_PERCENT=5

# How often to scan (minutes) when using --schedule
SCAN_INTERVAL_MINUTES=2

# Kategori başına max sayfa (0 = tüm sayfalar, üst sınır 100)
MAX_PAGES=5

# --- Telegram (optional) ---
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

STATUS_NOTIFICATIONS=true

# --- WhatsApp (optional) ---
# CallMeBot: +34 644 49 79 80 rehbere ekle →
# "I allow callmebot to send me messages" yaz → apikey al
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=callmebot
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
# Meta Cloud API:
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Email / SMTP (optional) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
