# Amazon domain: com, com.tr, de, co.uk, ...
AMAZON_DOMAIN=com.tr

# Minimum price drop to notify (percent). Example: 5 = %5+ düşüş
MIN_DROP_PERCENT=5
# Minimum price increase to notify (percent)
MIN_INCREASE_PERCENT=5
NOTIFY_PRICE_INCREASES=false

# How often to scan (minutes) when using --schedule
SCAN_INTERVAL_MINUTES=2

# Kategori başına max sayfa (0 = tüm sayfalar, üst sınır 100)
MAX_PAGES=5

# Aynı anda kaç kategori taransın (her biri ayrı Chrome; 2-4 önerilir)
SCAN_WORKERS=4

# --- Telegram (optional) ---
# 1) @BotFather ile bot oluştur, token al
# 2) Bot'a bir mesaj yaz
# 3) https://api.telegram.org/bot<TOKEN>/getUpdates ile chat_id bul
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=8706442391:AAEBTdNZ7wtars5g1hM4wKmAR28qqxu1Kms
TELEGRAM_CHAT_ID=1094704573

# Her tarama sonrası özet durum mesajı (true/false)
STATUS_NOTIFICATIONS=false

# --- WhatsApp (optional) ---
# Önerilen: CallMeBot (kişisel, ücretsiz kurulum)
# 1) WhatsApp'ta +34 644 49 79 80 numarasını rehbere ekle
# 2) Ona şu mesajı at: I allow callmebot to send me messages
# 3) Botun verdiği apikey'i aşağı yaz
# 4) WHATSAPP_PHONE = ülke kodu + numara (örn. 905551234567, + yok)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=callmebot
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
# Alternatif: Meta Cloud API (görsel + resmi kanal)
# WHATSAPP_PROVIDER=meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Email / SMTP (optional) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
